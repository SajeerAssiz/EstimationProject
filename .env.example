# D365 F&O ERP Estimation Tool - Environment Configuration
# Copy this file to .env and update with your values

# Azure AD Configuration (Required for multi-user authentication)
# Get these from Azure Portal > Azure AD > App registrations
VITE_AZURE_CLIENT_ID=your-application-client-id
VITE_AZURE_TENANT_ID=your-directory-tenant-id

# D365 CRM Configuration (Optional, for CRM integration)
# Your Dynamics 365 CRM organization URL
VITE_CRM_ORG_URL=https://yourorg.crm.dynamics.com
